# Set provider to openai, openai_compatible, ollama, or huggingface.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# Used only when LLM_PROVIDER=huggingface. Create a token at https://huggingface.co/settings/tokens.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

DATABASE_URL=sqlite:///data/college_academic_assistant.db
# Set FLASK_SECRET_KEY to a strong random value before production deployment.
FLASK_SECRET_KEY=
# Set true when the API is served over HTTPS in production.
SESSION_COOKIE_SECURE=false

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMENTS_DIR=data/documents
INDEX_DIR=data/index
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
